# ========================================================
# GVKSS Organic Products Website - Backend Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/organic_products_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/organic_products_db

# Security & Authentication
JWT_ACCESS_SECRET=gvkss_super_secure_access_secret_key_2026_xyz987
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=gvkss_super_secure_refresh_secret_key_2026_abc123
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=gvkss_cookie_signing_secret_998877

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin Initial Provisioning
INITIAL_ADMIN_EMAIL=admin@gvkss.org
INITIAL_ADMIN_PASSWORD=AdminSecure@2026!
INITIAL_ADMIN_NAME="GVKSS Master Admin"

# Store & UPI Defaults
BUSINESS_UPI_ID=gvkssorganics@upi
BUSINESS_DISPLAY_NAME="GVKSS Organic Collectives"
BUSINESS_EMAIL=ddshyderabad@gmail.com
BUSINESS_PHONE=9391628344

# SMTP / Email Notifications (Mock / In-memory fallback if disabled)
