# ========================================================
# GVKSS Organic Products Website - Central Backend Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
CLIENT_URL=https://www.YOURDOMAIN.com
ADMIN_URL=https://admin.YOURDOMAIN.com

# Database (MongoDB Atlas)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/organic_products_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/organic_products_db?retryWrites=true&w=majority

# Security & Authentication
JWT_ACCESS_SECRET=gvkss_super_secure_access_secret_key_2026_xyz987_replace_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=gvkss_super_secure_refresh_secret_key_2026_abc123_replace_in_prod
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=gvkss_cookie_signing_secret_998877_replace_in_prod
COOKIE_DOMAIN=.YOURDOMAIN.com

# CORS Allowed Origins (Comma-separated exact origins)
CORS_ORIGIN=https://www.YOURDOMAIN.com,https://admin.YOURDOMAIN.com,http://localhost:5173,http://localhost:5174

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Initial Provisioning (Created automatically on startup if absent)
INITIAL_ADMIN_EMAIL=admin@gvkss.org
INITIAL_ADMIN_PASSWORD=AdminSecure@2026!
INITIAL_ADMIN_NAME="GVKSS Master Admin"

# Store & UPI Defaults
BUSINESS_UPI_ID=9494300473@okbizaxis
BUSINESS_DISPLAY_NAME="GVKSS Organics"
BUSINESS_EMAIL=contact@gvkss.org
BUSINESS_PHONE=+919494300473

# Resend / SMTP Email Notifications (In-memory simulation if false)
ENABLE_EMAIL=false
RESEND_API_KEY=
EMAIL_FROM="GVKSS Organics <orders@YOURDOMAIN.com>"
