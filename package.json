{
  "name": "organic-store-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:storefront": "npm --prefix apps/storefront run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "build:storefront": "npm --prefix apps/storefront run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:backend": "npm --prefix apps/backend run build",
    "build:all": "npm run build:backend && npm run build:storefront && npm run build:admin",
    "test:backend": "npm --prefix apps/backend run test",
    "seed:backend": "npm --prefix apps/backend run seed",
    "dev": "npm --prefix apps/storefront run dev",
    "build": "npm --prefix apps/storefront run build",
    "server:dev": "npm --prefix apps/backend run dev",
    "server:build": "npm --prefix apps/backend run build",
    "server:test": "npm --prefix apps/backend run test",
    "server:seed": "npm --prefix apps/backend run seed",
    "lint": "oxlint"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
